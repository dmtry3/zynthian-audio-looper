@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix time:   <http://lv2plug.in/ns/ext/time#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix work:   <http://lv2plug.in/ns/ext/worker#> .
@prefix state:  <http://lv2plug.in/ns/ext/state#> .
@prefix patch:  <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<urn:audiolooper:looper#g_rec> a pg:Group ; lv2:symbol "g_rec" ; lv2:name "Record" ; lv2:index 0 ; lv2:displayPriority 60 .
<urn:audiolooper:looper#g_track> a pg:Group ; lv2:symbol "g_track" ; lv2:name "Track" ; lv2:index 1 ; lv2:displayPriority 50 .
<urn:audiolooper:looper#g_nav> a pg:Group ; lv2:symbol "g_nav" ; lv2:name "Navigate" ; lv2:index 2 ; lv2:displayPriority 40 .
<urn:audiolooper:looper#g_screens> a pg:Group ; lv2:symbol "g_screens" ; lv2:name "Screens" ; lv2:index 3 ; lv2:displayPriority 30 .
<urn:audiolooper:looper#g_mix> a pg:Group ; lv2:symbol "g_mix" ; lv2:name "Mix" ; lv2:index 4 ; lv2:displayPriority 20 .

<urn:audiolooper:looper>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "Audio Looper" ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    lv2:requiredFeature urid:map , work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData work:interface , state:interface ;
    patch:writable
        <urn:audiolooper:looper#rec_order> ,
        <urn:audiolooper:looper#mode> ,
        <urn:audiolooper:looper#len1> ,
        <urn:audiolooper:looper#len2> ,
        <urn:audiolooper:looper#len3> ,
        <urn:audiolooper:looper#len4> ,
        <urn:audiolooper:looper#fade_out> ,
        <urn:audiolooper:looper#fade_in> ,
        <urn:audiolooper:looper#rev_time> ,
        <urn:audiolooper:looper#mute_q> ,
        <urn:audiolooper:looper#part_q> ,
        <urn:audiolooper:looper#lev1> ,
        <urn:audiolooper:looper#lev2> ,
        <urn:audiolooper:looper#lev3> ,
        <urn:audiolooper:looper#lev4> ,
        <urn:audiolooper:looper#lev5> ,
        <urn:audiolooper:looper#lev6> ,
        <urn:audiolooper:looper#lev7> ,
        <urn:audiolooper:looper#lev8> ,
        <urn:audiolooper:looper#lev9> ,
        <urn:audiolooper:looper#lev10> ,
        <urn:audiolooper:looper#lev11> ,
        <urn:audiolooper:looper#lev12> ,
        <urn:audiolooper:looper#lev13> ,
        <urn:audiolooper:looper#lev14> ,
        <urn:audiolooper:looper#lev15> ,
        <urn:audiolooper:looper#lev16> ,
        <urn:audiolooper:looper#pan1> ,
        <urn:audiolooper:looper#pan2> ,
        <urn:audiolooper:looper#pan3> ,
        <urn:audiolooper:looper#pan4> ,
        <urn:audiolooper:looper#pan5> ,
        <urn:audiolooper:looper#pan6> ,
        <urn:audiolooper:looper#pan7> ,
        <urn:audiolooper:looper#pan8> ,
        <urn:audiolooper:looper#pan9> ,
        <urn:audiolooper:looper#pan10> ,
        <urn:audiolooper:looper#pan11> ,
        <urn:audiolooper:looper#pan12> ,
        <urn:audiolooper:looper#pan13> ,
        <urn:audiolooper:looper#pan14> ,
        <urn:audiolooper:looper#pan15> ,
        <urn:audiolooper:looper#pan16> ,
        <urn:audiolooper:looper#chm1> ,
        <urn:audiolooper:looper#chm2> ,
        <urn:audiolooper:looper#chm3> ,
        <urn:audiolooper:looper#chm4> ,
        <urn:audiolooper:looper#chm5> ,
        <urn:audiolooper:looper#chm6> ,
        <urn:audiolooper:looper#chm7> ,
        <urn:audiolooper:looper#chm8> ,
        <urn:audiolooper:looper#chm9> ,
        <urn:audiolooper:looper#chm10> ,
        <urn:audiolooper:looper#chm11> ,
        <urn:audiolooper:looper#chm12> ,
        <urn:audiolooper:looper#chm13> ,
        <urn:audiolooper:looper#chm14> ,
        <urn:audiolooper:looper#chm15> ,
        <urn:audiolooper:looper#chm16> ,
        <urn:audiolooper:looper#dry> ,
        <urn:audiolooper:looper#master> ,
        <urn:audiolooper:looper#limiter> ;
    lv2:port
    [
        a lv2:InputPort , lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L" ;
    ] , [
        a lv2:InputPort , lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R" ;
    ] , [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position , patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 4 ; lv2:symbol "events_in" ; lv2:name "MIDI In" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "rec" ; lv2:name "Rec/Dub" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ; pg:group <urn:audiolooper:looper#g_rec> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "undo" ; lv2:name "Undo" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:audiolooper:looper#g_rec> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "redo" ; lv2:name "Redo" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:audiolooper:looper#g_rec> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "reset" ; lv2:name "Reset" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:audiolooper:looper#g_rec> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "mute" ; lv2:name "Mute" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ; pg:group <urn:audiolooper:looper#g_track> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "reverse" ; lv2:name "Reverse" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:audiolooper:looper#g_track> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "lock" ; lv2:name "Lock" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:audiolooper:looper#g_track> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "trk_next" ; lv2:name "Next Trk" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:audiolooper:looper#g_track> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ; lv2:symbol "trk_prev" ; lv2:name "Prev Trk" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ; pg:group <urn:audiolooper:looper#g_nav> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ; lv2:symbol "part_next" ; lv2:name "Next Part" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:audiolooper:looper#g_nav> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ; lv2:symbol "part_prev" ; lv2:name "Prev Part" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 20 ; pg:group <urn:audiolooper:looper#g_nav> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "play" ; lv2:name "Play/Stop" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <urn:audiolooper:looper#g_nav> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "w_loop" ; lv2:name "Loop" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ; pg:group <urn:audiolooper:looper#g_screens> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "w_mixer" ; lv2:name "Mixer" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ; pg:group <urn:audiolooper:looper#g_screens> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0 ; lv2:minimum -60 ; lv2:maximum 6 ;
        lv2:displayPriority 40 ; pg:group <urn:audiolooper:looper#g_mix> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "pan" ; lv2:name "Pan" ;
        lv2:default 0 ; lv2:minimum -100 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <urn:audiolooper:looper#g_mix> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 21 ; lv2:symbol "master" ; lv2:name "Master" ;
        lv2:default 0 ; lv2:minimum -60 ; lv2:maximum 6 ;
        lv2:displayPriority 20 ; pg:group <urn:audiolooper:looper#g_mix> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 22 ; lv2:symbol "speed" ; lv2:name "Speed" ;
        lv2:default 1 ; lv2:minimum 0.5 ; lv2:maximum 2 ; lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 10 ; pg:group <urn:audiolooper:looper#g_mix> ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 23 ; lv2:symbol "o_track" ; lv2:name "Out: Track" ;
        lv2:minimum 0 ; lv2:maximum 3 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 24 ; lv2:symbol "o_part" ; lv2:name "Out: Part" ;
        lv2:minimum 0 ; lv2:maximum 3 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 25 ; lv2:symbol "o_pend" ; lv2:name "Out: Pending" ;
        lv2:minimum -1 ; lv2:maximum 3 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 26 ; lv2:symbol "o_widget" ; lv2:name "Out: Widget" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 27 ; lv2:symbol "o_action" ; lv2:name "Out: Action" ;
        lv2:minimum 0 ; lv2:maximum 15 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 28 ; lv2:symbol "o_act_cnt" ; lv2:name "Out: Act Count" ;
        lv2:minimum 0 ; lv2:maximum 1000000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 29 ; lv2:symbol "o_held" ; lv2:name "Out: Held" ;
        lv2:minimum 0 ; lv2:maximum 65535 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 30 ; lv2:symbol "o_bpm" ; lv2:name "Out: BPM" ;
        lv2:minimum 0 ; lv2:maximum 400 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 31 ; lv2:symbol "o_bar" ; lv2:name "Out: Bar" ;
        lv2:minimum 0 ; lv2:maximum 1000000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 32 ; lv2:symbol "o_beat" ; lv2:name "Out: Beat" ;
        lv2:minimum 0 ; lv2:maximum 16 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 33 ; lv2:symbol "o_bpb" ; lv2:name "Out: BPB" ;
        lv2:minimum 1 ; lv2:maximum 16 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 34 ; lv2:symbol "o_rolling" ; lv2:name "Out: Rolling" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 35 ; lv2:symbol "o_tsrc" ; lv2:name "Out: Tempo Src" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 36 ; lv2:symbol "o_clk_bpm" ; lv2:name "Out: Clock BPM" ;
        lv2:minimum 0 ; lv2:maximum 400 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 37 ; lv2:symbol "o_pos_cnt" ; lv2:name "Out: Pos Msgs" ;
        lv2:minimum 0 ; lv2:maximum 1000000 ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:index 38 ; lv2:symbol "events_out" ; lv2:name "Events Out" ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 39 ; lv2:symbol "o_st1" ; lv2:name "Out: State 1" ;
        lv2:minimum 0 ; lv2:maximum 4 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 40 ; lv2:symbol "o_st2" ; lv2:name "Out: State 2" ;
        lv2:minimum 0 ; lv2:maximum 4 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 41 ; lv2:symbol "o_st3" ; lv2:name "Out: State 3" ;
        lv2:minimum 0 ; lv2:maximum 4 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 42 ; lv2:symbol "o_st4" ; lv2:name "Out: State 4" ;
        lv2:minimum 0 ; lv2:maximum 4 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 43 ; lv2:symbol "o_pos1" ; lv2:name "Out: Pos 1" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 44 ; lv2:symbol "o_pos2" ; lv2:name "Out: Pos 2" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 45 ; lv2:symbol "o_pos3" ; lv2:name "Out: Pos 3" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 46 ; lv2:symbol "o_pos4" ; lv2:name "Out: Pos 4" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 47 ; lv2:symbol "o_len1" ; lv2:name "Out: Len 1" ;
        lv2:minimum 0 ; lv2:maximum 100000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 48 ; lv2:symbol "o_len2" ; lv2:name "Out: Len 2" ;
        lv2:minimum 0 ; lv2:maximum 100000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 49 ; lv2:symbol "o_len3" ; lv2:name "Out: Len 3" ;
        lv2:minimum 0 ; lv2:maximum 100000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 50 ; lv2:symbol "o_len4" ; lv2:name "Out: Len 4" ;
        lv2:minimum 0 ; lv2:maximum 100000 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 51 ; lv2:symbol "o_flags" ; lv2:name "Out: Flags" ;
        lv2:minimum 0 ; lv2:maximum 33554431 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 52 ; lv2:symbol "o_pool" ; lv2:name "Out: Pool" ;
        lv2:minimum 0 ; lv2:maximum 1 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 53 ; lv2:symbol "o_parts" ; lv2:name "Out: Parts" ;
        lv2:minimum 0 ; lv2:maximum 15 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 54 ; lv2:symbol "o_pk1" ; lv2:name "Out: Peak 1" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 55 ; lv2:symbol "o_pk2" ; lv2:name "Out: Peak 2" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 56 ; lv2:symbol "o_pk3" ; lv2:name "Out: Peak 3" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 57 ; lv2:symbol "o_pk4" ; lv2:name "Out: Peak 4" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 58 ; lv2:symbol "o_mpk_l" ; lv2:name "Out: Master Peak L" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 59 ; lv2:symbol "o_mpk_r" ; lv2:name "Out: Master Peak R" ;
        lv2:minimum 0 ; lv2:maximum 2 ;
    ] .

# Настройки: LV2-параметры (patch:Set), скрыты со страниц, меняются на вкладке настроек виджета.
<urn:audiolooper:looper#rec_order>
    a lv2:Parameter ;
    lv2:symbol "rec_order" ;
    rdfs:label "Rec Order" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#mode>
    a lv2:Parameter ;
    lv2:symbol "mode" ;
    rdfs:label "Mode" ;
    rdfs:range atom:Int ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#len1>
    a lv2:Parameter ;
    lv2:symbol "len1" ;
    rdfs:label "Length 1" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#len2>
    a lv2:Parameter ;
    lv2:symbol "len2" ;
    rdfs:label "Length 2" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#len3>
    a lv2:Parameter ;
    lv2:symbol "len3" ;
    rdfs:label "Length 3" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#len4>
    a lv2:Parameter ;
    lv2:symbol "len4" ;
    rdfs:label "Length 4" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#fade_out>
    a lv2:Parameter ;
    lv2:symbol "fade_out" ;
    rdfs:label "Fade Out" ;
    rdfs:range atom:Int ;
    lv2:default 200 ; lv2:minimum 10 ; lv2:maximum 4000 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#fade_in>
    a lv2:Parameter ;
    lv2:symbol "fade_in" ;
    rdfs:label "Fade In" ;
    rdfs:range atom:Int ;
    lv2:default 200 ; lv2:minimum 10 ; lv2:maximum 4000 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#rev_time>
    a lv2:Parameter ;
    lv2:symbol "rev_time" ;
    rdfs:label "Reverse Time" ;
    rdfs:range atom:Int ;
    lv2:default 50 ; lv2:minimum 5 ; lv2:maximum 1000 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:audiolooper:looper#mute_q>
    a lv2:Parameter ;
    lv2:symbol "mute_q" ;
    rdfs:label "Mute Quant" ;
    rdfs:range atom:Int ;
    lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 3 ;
    pprops:notOnGUI true ;
